{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.schema.json",
  "title": "FILE_SPLIT_SYSTEM child job",
  "type": "object",
  "required": ["schema_version", "rule_version", "job_id", "parent_root_task_id", "mode", "illustrator_connection_attempts", "illustrator_connection_failures", "jsx_started_count", "jsx_completed_count", "jsx_logic_failures", "export_count", "final_status"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "rule_version": {"const": "1.3.0"},
    "job_id": {"type": "string"},
    "parent_root_task_id": {"type": "string", "pattern": "^root-"},
    "mode": {"enum": ["fast_production", "diagnostic_development"]},
    "illustrator_connection_attempts": {"type": "integer", "minimum": 0},
    "illustrator_connection_failures": {"type": "integer", "minimum": 0},
    "jsx_started_count": {"type": "integer", "minimum": 0},
    "jsx_completed_count": {"type": "integer", "minimum": 0},
    "jsx_logic_failures": {"type": "integer", "minimum": 0},
    "logic_retry_count": {"type": "integer", "minimum": 0, "maximum": 0},
    "export_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "current_stage": {"type": "string"},
    "final_status": {"enum": ["pending", "system_not_ready", "environment_unavailable", "source_needs_review", "production_failed", "sla_exceeded", "qa_passed"]},
    "failure_stage": {"type": ["string", "null"]},
    "failure_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
