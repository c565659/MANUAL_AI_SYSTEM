{
  "schema_version": "1.3.0",
  "rule_version": "1.3.0",
  "system_name": "文件拆分处理系统",
  "task_types": [
    "WEB_MANUAL",
    "PACKAGING_DISPLAY"
  ],
  "status_values": [
    "pending",
    "classified",
    "analyzed",
    "processing",
    "exported",
    "qa_passed",
    "needs_review",
    "failed",
    "system_not_ready",
    "environment_unavailable",
    "source_needs_review",
    "production_failed",
    "sla_exceeded"
  ],
  "execution": {
    "default_mode": "fast_production",
    "available_modes": [
      "fast_production",
      "diagnostic_development"
    ],
    "production_target_seconds": 600,
    "production_hard_limit_seconds": 900,
    "preflight_target_seconds": 60,
    "output_conflict_check_seconds": 30,
    "illustrator_connection_timeout_seconds": 30,
    "connection_retry_delay_seconds": 5,
    "max_connection_retries_before_jsx": 1,
    "max_logic_retries": 0,
    "single_illustrator_invocation": true,
    "max_illustrator_invocations": 1,
    "max_probe_runs": 1,
    "max_retries": 0,
    "max_exports": 1,
    "persist_job_state": true,
    "continue_failed_job_without_explicit_diagnostic_permission": false,
    "use_measured_wall_clock_time": true,
    "allow_runtime_script_patching": false,
    "allow_per_page_intermediate_export": false,
    "allow_intermediate_rendering": false,
    "allow_mouse_keyboard_automation": false,
    "allow_app_activate": false,
    "reuse_stable_scripts": true
  },
  "qa": {
    "mode": "final_only",
    "contact_sheet_resolution_ppi": 72,
    "render_each_page_separately": false,
    "allow_read_only_pdf_structure_analysis": true
  },
  "classification": {
    "strategy": "content_and_structure",
    "extension_only_allowed": false,
    "user_declared_purpose_precedence": true,
    "pause_on_material_conflict": true,
    "classify_each_source_independently": true,
    "distinguish_source_and_reference": true,
    "ocr_for_analysis_only": true
  },
  "output_naming": {
    "WEB_MANUAL": "{model}_WELCOME GUIDE.pdf",
    "PACKAGING_DISPLAY": "{model}_包装效果图.png"
  },
  "manual": {
    "artboard_gap_mm": 0,
    "artboard_layout": "single_row",
    "outline_text": true,
    "preserve_source_page_size": true,
    "preserve_body_page_numbers": true,
    "export_multipage_pdf": true,
    "real_object_splitting_required": true,
    "allow_whole_source_symbol_pagination": false,
    "allow_page_level_whole_source_clipping": false,
    "remove_off_artboard_objects": true,
    "purge_unused_symbols": true,
    "center_artboard_strip_in_coordinate_range": true
  },
  "font_safety": {
    "check_before_outline": true,
    "allow_font_substitution": false,
    "allow_unresolved_fonts": false,
    "outline_retained_pages_only": true,
    "verify_outline_geometry": true,
    "max_targeted_visual_qa_pages": 3
  },
  "pdf_performance": {
    "preserve_editability": false,
    "generate_thumbnails": false,
    "optimization": true,
    "view_after_saving": false,
    "allow_full_source_shared_xobject": false,
    "allow_page_group_bounds_near_source_canvas": false
  },
  "packaging": {
    "face_gap_mm": 10,
    "resolution_ppi": 300,
    "background": "white",
    "preserve_orientation": true,
    "export_single_image": true,
    "face_border_width_pt": null,
    "canvas_margin_mm": null
  },
  "color": {
    "preserve_source_colors": true,
    "green_spot_name": "2286C",
    "require_verified_spot_definition": true,
    "allow_rgb_conversion_at_png_export_only": true,
    "preserve_document_color_mode": true
  },
  "paths": {
    "input_directory": null,
    "output_directory": null,
    "temporary_directory": null
  },
  "repository": {
    "commit_user_sources_by_default": false,
    "commit_outputs_by_default": false,
    "commit_full_logs_by_default": false,
    "public_repository": true
  }
}
