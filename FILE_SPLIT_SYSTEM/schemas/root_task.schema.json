{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "root_task.schema.json",
  "title": "FILE_SPLIT_SYSTEM root task",
  "type": "object",
  "required": ["schema_version", "rule_version", "root_task_id", "source_path", "source_sha256", "requested_output", "root_started_at", "root_finished_at", "root_elapsed_seconds", "cumulative_codex_elapsed_seconds", "cumulative_preflight_seconds", "cumulative_illustrator_seconds", "cumulative_export_seconds", "cumulative_qa_seconds", "child_job_count", "total_connection_attempts", "total_jsx_started_count", "total_logic_retries", "final_status"],
  "properties": {
    "schema_version": {"const": "1.4.0"},
    "rule_version": {"const": "1.4.0"},
    "root_task_id": {"type": "string", "pattern": "^root-[0-9a-f]{24}$"},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "requested_output": {"type": "string", "minLength": 1},
    "root_started_at": {"type": "string"},
    "root_finished_at": {"type": ["string", "null"]},
    "root_elapsed_seconds": {"type": "number", "minimum": 0},
    "cumulative_codex_elapsed_seconds": {"type": "number", "minimum": 0},
    "cumulative_preflight_seconds": {"type": "number", "minimum": 0},
    "cumulative_illustrator_seconds": {"type": "number", "minimum": 0},
    "cumulative_export_seconds": {"type": "number", "minimum": 0},
    "cumulative_qa_seconds": {"type": "number", "minimum": 0},
    "child_job_count": {"type": "integer", "minimum": 0},
    "total_connection_attempts": {"type": "integer", "minimum": 0},
    "total_jsx_started_count": {"type": "integer", "minimum": 0},
    "total_logic_retries": {"type": "integer", "minimum": 0},
    "final_status": {"enum": ["pending", "system_not_ready", "environment_unavailable", "source_needs_review", "production_failed", "sla_exceeded", "qa_passed"]}
  },
  "additionalProperties": true
}
